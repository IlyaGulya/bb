{
  "name": "bb-plugin-bb--slack-inbox",
  "version": "0.1.0",
  "description": "Approved Slack human mentions into Inbox, with durable Socket Mode intake and explicit coverage gaps.",
  "private": true,
  "type": "module",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.27"
  },
  "bb": {
    "name": "Slack Inbox",
    "description": "Approved Slack human mentions into Inbox, with durable Socket Mode intake and explicit coverage gaps.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-pattern node_modules --ignore-pattern dist .",
    "test": "vitest run --config vitest.config.ts",
    "prepare:bundled": "bb-plugin-build prepare-bundled"
  },
  "dependencies": {
    "@slack/socket-mode": "3.1.0",
    "@slack/web-api": "8.2.0",
    "undici": "^7.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-build": "workspace:*",
    "@get-bb/plugin-sdk": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "better-sqlite3": "^12.6.2",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1",
    "ws": "^8.18.0"
  }
}
