{
  "name": "@bb/text-utils",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./markdown": {
      "source": "./src/markdown.ts",
      "types": "./src/markdown.ts",
      "default": "./src/markdown.ts"
    },
    "./markdown-plugins": {
      "source": "./src/markdown-plugins.ts",
      "types": "./src/markdown-plugins.ts",
      "default": "./src/markdown-plugins.ts"
    },
    "./markdown-html": {
      "source": "./src/markdown-html.ts",
      "types": "./src/markdown-html.ts",
      "default": "./src/markdown-html.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
